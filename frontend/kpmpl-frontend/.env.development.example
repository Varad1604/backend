# Local integration against the backend on your machine.
# cp .env.development.example .env.development.local && npm run dev   → http://localhost:5173
VITE_API_MODE=http
# demo shows the demo account picker (usernames only; the password is the backend's DEMO_PASSWORD).
VITE_APP_MODE=demo
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:3000
# Backend must allow Origin http://localhost:5173 in its CORS/Origin allowlist (writes check Origin).
# __Host- cookies need Secure: Chrome and Firefox accept Secure cookies on http://localhost; Safari does not (use HTTPS there).
