flowchart TB
    subgraph Z0["UNTRUSTED: browser / plant LAN"]
        B["React SPA"]
        B2["Mobile clients (bearer)"]
    end
    subgraph DMZ["DMZ: edge"]
        E["ONE reverse proxy - TLS, HSTS, CSP, XFF single hop, trusted-proxy list = 1"]
    end
    subgraph APPZ["APP zone (trusted)"]
        API["kpmpl-api"]
        LIM["In-process rate limiter - ADR-036 (no Redis)"]
        AV["clamd"]
    end
    subgraph DATAZ["DATA zone (trusted, private)"]
        PG[("PostgreSQL (roles: app_runtime INSERT-only audit, migrator, report_reader - PROPOSED ADR-026)")]
        S3[("Document store: Phase 1 local NTFS volume (ACLs, hash-on-read) / Phase 2 AWS S3 (versioning, object lock)")]
        AB[("Audit anchor storage: SEPARATE off-domain account, write-once credentials (object lock), signed with an off-host key - ADR-012 V1.2 / OD-13; daily head-hash copy sent outside IT")]
    end
    subgraph ERPZ["ERP zone (network-isolated)"]
        ERP[("DataMan SQL Server - readonly login, TLS, SELECT-only adapter gate")]
    end

    B -->|"HTTPS"| E
    B2 -->|"HTTPS"| E
    E -->|"session cookie __Host-kpmpl_sid or bearer + CSRF proof"| API
    API --> PG
    API --> LIM
    API --> AV
    API -->|"API-only access (NTFS ACLs; signed server-side requests in Phase 2)"| S3
    API -->|"anchor export (job)"| AB
    API -->|"parameterized SELECT/WITH only"| ERP

    CSRF["Cookie-authenticated writes: Origin allowlist + X-Requested-With + SameSite=Lax + __Host- prefix"]
    B -.-> CSRF
