{
  "name": "@kpmpl/api",
  "version": "0.1.0",
  "private": true,
  "description": "KPMPL shared backend - modular monolith (NestJS + Fastify). One API for web and future Android/iOS (build prompt sections 4.2-4.3).",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "migrate:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "postinstall": "prisma generate",
    "clean": "rm -rf dist",
    "seed": "node --env-file-if-exists=../../.env dist/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^10.1.6",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.0.1",
    "@prisma/client": "^6.4.0",
    "argon2": "0.45.1",
    "fastify": "5.12.5",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "9.0.3",
    "mssql": "12.7.14",
    "prisma": "^6.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.11.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "4.1.12"
  }
}
