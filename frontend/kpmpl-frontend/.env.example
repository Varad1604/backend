# KPMPL Gate-to-Bill frontend — environment (Vite reads these at BUILD/dev time; nothing here is secret).
# Copy to .env.local for local overrides. Never put credentials in a VITE_* variable: they ship in the bundle.

# mock (default) = synthetic in-browser adapter, no server. http = real backend.
VITE_API_MODE=mock

# demo = demo strip, Demo tools (mock only) and demo account picker. production = all hidden.
# Default: demo for mock, production for http. production requires http.
VITE_APP_MODE=demo

# Base path of the API. Keep it same-origin ("/api/v1") and let the Vite proxy (dev) or nginx (prod)
# forward it, so the __Host-kpmpl_sid session cookie stays first-party. An absolute URL must be https in production.
VITE_API_BASE_URL=/api/v1

# Per-request timeout in ms (uploads get 6x). Default 20000.
# VITE_API_TIMEOUT_MS=20000

# Dev/preview server only: where `/api` is proxied. Default http://localhost:3000.
# VITE_PROXY_TARGET=http://localhost:3000
