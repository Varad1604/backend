// KPMPL shared backend - Prisma schema (P0 core)
// Implements the P0 slice of the ER model in KPMPL_Master_Build_Prompt_v1.0.md section 5.2:
// identity/roles, sessions (5-concurrent enforcement basis), append-only hash-chained
// audit, and idempotency records. Domain tables (visits, weighments, QC, ...) land in
// their build phases (P2-P6) as separate migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- identity & access (module: identity-access) ----------

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique // gate | qc_operator | qc_manager | gate_doc_authority | ho_accounts | plant_head | head_accounts | viewer | admin
  description String?
  createdAt   DateTime @default(now())
  userRoles   UserRole[]
  capabilities RoleCapability[]
}

model Capability {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  roles       RoleCapability[]
}

model RoleCapability {
  roleId       Int
  capabilityId Int
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  capability    Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([roleId, capabilityId])
  @@index([capabilityId])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  fullName     String
  employeeCode String?   @unique
  passwordHash String // argon2id (activated in P1)
  isActive     Boolean   @default(true)
  mustChangePassword Boolean @default(false)
  synthetic    Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userRoles    UserRole[]
  sessions     Session[]
  receivingVisits ReceivingVisit[]
  weighments Weighment[]
  qcInspections QCInspection[]
  qcRevisions QCRevision[]
  qcReviews QCReview[]
  packageCorrectionsRequested PackageCorrection[]
  vehicleExits VehicleExit[]
  grnReferences GRNReference[]
  grnLinks GRNLink[]
  documentPackagesCreated DocumentPackage[] @relation("PackageCreator")
  documentPackagesSubmitted DocumentPackage[] @relation("PackageSubmitter")
  documentFiles DocumentFile[]
  packageHistory PackageHistory[]
  erpMilestones ErpMilestone[]
  reminders Reminder[]
}

model UserRole {
  userId    String   @db.Uuid
  roleId    Int
  grantedBy String?
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ---------- sessions (refresh-token rotation; R5 cap of 5 concurrent enforced here in P1) ----------

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  csrfTokenHash    String?
  clientType       String    @default("web")
  refreshHistory   RefreshTokenHistory[]
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  lastSeenAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- audit (append-only + hash-chained; no UPDATE/DELETE in app code, ever) ----------

model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  entityType String
  entityId   String
  action     String
  actorId    String?  @db.Uuid
  oldValue   Json?
  newValue   Json?
  reason     String?
  source     String   @default("app")
  prevHash   String?  @db.Char(64)
  rowHash    String   @db.Char(64)
  recordedAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, recordedAt])
}

// ---------- idempotency (safe retries for all writes) ----------

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  method         String
  path           String
  key            String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  status         String    @default("in_progress") // in_progress | completed
  createdAt      DateTime  @default(now())
  expiresAt      DateTime

  @@unique([userId, method, path, key])
}

model RefreshTokenHistory {
  tokenHash String @id
  sessionId String @db.Uuid
  expiresAt DateTime
  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  @@index([sessionId])
}

model ReceivingVisit {
  id String @id @default(uuid()) @db.Uuid
  officialGateEntryRef String
  vehicleNumber String
  supplierDisplayName String?
  materialDisplayName String?
  challanRef String?
  poRef String?
  arrivedAt DateTime?
  notes String?
  isDemo Boolean @default(true)
  visitStatus String @default("created")
  version Int @default(1)
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  weighments Weighment[]
  qcInspections QCInspection[]
  vehicleExit VehicleExit?
  grnLinks GRNLink[]
  packageLink PackageVisit?
  @@index([officialGateEntryRef])
  @@index([createdAt, id])
}

model Weighment {
  id String @id @default(uuid()) @db.Uuid
  visitId String @db.Uuid
  kind String
  value Decimal @db.Decimal(12, 3)
  unit String
  recordedBy String @db.Uuid
  recordedAt DateTime @default(now())
  correctsId String? @unique @db.Uuid
  reason String?
  visit ReceivingVisit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  recorder User @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  corrects Weighment? @relation("WeightCorrections", fields: [correctsId], references: [id], onDelete: Restrict)
  corrections Weighment[] @relation("WeightCorrections")
  @@index([visitId, recordedAt])
}

model QCInspection {
  id String @id @default(uuid()) @db.Uuid
  visitId String @db.Uuid
  qcStatus String @default("submitted")
  currentRevisionId String? @unique @db.Uuid
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  visit ReceivingVisit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  currentRevision QCRevision? @relation("CurrentQCRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  revisions QCRevision[] @relation("QCRevisions")
  reviews QCReview[]
  @@index([visitId])
}
model QCRevision {
  id String @id @default(uuid()) @db.Uuid
  inspectionId String @db.Uuid
  revisionNo Int
  state String @default("submitted")
  clearance String @default("pending")
  visitVersion Int?
  measurements Json
  remarks String?
  reason String?
  revisionReason String?
  submittedBy String @db.Uuid
  submittedAt DateTime @default(now())
  supersedesId String? @unique @db.Uuid
  inspection QCInspection @relation("QCRevisions", fields: [inspectionId], references: [id], onDelete: Restrict)
  currentIn QCInspection? @relation("CurrentQCRevision")
  submitter User @relation(fields: [submittedBy], references: [id], onDelete: Restrict)
  supersedes QCRevision? @relation("QCRevisionCorrections", fields: [supersedesId], references: [id], onDelete: Restrict)
  corrections QCRevision[] @relation("QCRevisionCorrections")
  measurementRows QCMeasurement[]
  @@unique([inspectionId, revisionNo])
}
model QCReview {
  id String @id @default(uuid()) @db.Uuid
  inspectionId String @db.Uuid
  outcome String
  reason String
  // true only on decisions recorded before D-03 was decided (2026-11-03); new decisions are real.
  demonstrationOnly Boolean @default(false)
  forRevision Int
  recordedBy String @db.Uuid
  recordedAt DateTime @default(now())
  inspection QCInspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  recorder User @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  @@index([inspectionId])
}
model QCMeasurement {
  id String @id @default(uuid()) @db.Uuid
  revisionId String @db.Uuid
  code String
  value Decimal @db.Decimal(5, 2)
  unit String @default("percent")
  recordedAt DateTime @default(now())
  revision QCRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  @@index([revisionId])
}
model VehicleExit {
  id String @id @default(uuid()) @db.Uuid
  visitId String @unique @db.Uuid
  physicalExitAt DateTime
  recordedAt DateTime @default(now())
  recordedBy String @db.Uuid
  remarks String?
  visit ReceivingVisit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  recorder User @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
}
model GRNReference {
  id String @id @default(uuid()) @db.Uuid
  officialGrnRef String
  verifiedBy String @db.Uuid
  recordedAt DateTime @default(now())
  source String @default("manual_staff_confirmation")
  verifier User @relation(fields: [verifiedBy], references: [id], onDelete: Restrict)
  links GRNLink[]
  @@index([officialGrnRef])
}
model GRNLink {
  id String @id @default(uuid()) @db.Uuid
  visitId String @db.Uuid
  grnReferenceId String @db.Uuid
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  visit ReceivingVisit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  reference GRNReference @relation(fields: [grnReferenceId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@unique([visitId, grnReferenceId])
}

// ---------- Module 2: document packages, HO review and manual ERP milestones ----------

model DocumentPackage {
  id                  String    @id @default(uuid()) @db.Uuid
  packageRef          String    @unique
  invoiceRef          String?
  supplierDisplayName String?
  status              String    @default("draft")
  checklistVersion    Int       @default(1)
  version             Int       @default(1)
  createdBy           String    @db.Uuid
  submittedBy         String?   @db.Uuid
  submittedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  creator             User      @relation("PackageCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  submitter           User?     @relation("PackageSubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
  visits              PackageVisit[]
  items               PackageItem[]
  files               DocumentFile[]
  corrections         PackageCorrection[]
  erp                  ErpMilestone[]
  reminders           Reminder[]
  history             PackageHistory[]

  @@index([status, updatedAt])
}

model PackageVisit {
  packageId String @db.Uuid
  visitId   String @unique @db.Uuid
  package   DocumentPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  visit     ReceivingVisit  @relation(fields: [visitId], references: [id], onDelete: Restrict)
  @@id([packageId, visitId])
}

model PackageItem {
  id                  String   @id @default(uuid()) @db.Uuid
  packageId           String   @db.Uuid
  category            String
  position            Int
  notApplicableReason String?
  hoCheck             String   @default("unchecked")
  hoNote              String?
  package             DocumentPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  @@unique([packageId, category])
  @@unique([packageId, position])
}

model DocumentFile {
  id           String    @id @default(uuid()) @db.Uuid
  packageId    String    @db.Uuid
  category     String
  storageKey   String    @unique
  sha256       String    @db.Char(64)
  size         Int
  originalName String
  scanStatus   String    @default("pending_scan")
  uploadedBy   String    @db.Uuid
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?
  package      DocumentPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  uploader     User @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  @@index([packageId, category, deletedAt])
}

model PackageCorrection {
  id           String   @id @default(uuid()) @db.Uuid
  packageId    String   @db.Uuid
  reason       String
  categories   Json
  requestedBy  String?  @db.Uuid
  requestedAt  DateTime @default(now())
  resolvedAt   DateTime?
  responseNote String?
  package      DocumentPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  requester    User? @relation(fields: [requestedBy], references: [id], onDelete: Restrict)
}

model ErpMilestone {
  id              String    @id @default(uuid()) @db.Uuid
  packageId       String    @db.Uuid
  type            String
  status          String    @default("pending")
  dataManRef      String?
  erpOccurredAt   DateTime?
  note            String?
  confirmedAt     DateTime?
  confirmedBy     String?   @db.Uuid
  reversedAt      DateTime?
  reversalReason  String?
  source          String    @default("manual_staff_confirmation")
  package         DocumentPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  confirmer       User? @relation(fields: [confirmedBy], references: [id], onDelete: Restrict)
  @@unique([packageId, type])
}

model ReferenceValue {
  id        String   @id @default(uuid()) @db.Uuid
  kind      String
  value     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, value])
}

model Reminder {
  id         String   @id @default(uuid()) @db.Uuid
  packageId  String   @db.Uuid
  note       String
  recipient  String   @default("Plant Head")
  channel    String   @default("pending")
  recordedBy String   @db.Uuid
  recordedAt DateTime @default(now())
  package    DocumentPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  recorder   User @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
}

model PackageHistory {
  id         String   @id @default(uuid()) @db.Uuid
  packageId  String   @db.Uuid
  action     String
  detail     String?
  source     String   @default("app")
  actorId    String   @db.Uuid
  recordedAt DateTime @default(now())
  package    DocumentPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  actor      User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([packageId, recordedAt])
}
