# Copy to .env for local development:  cp .env.example .env
# The application refuses to boot with invalid/missing config (build prompt section 11).

# --- runtime ---
NODE_ENV=development
PORT=3000
# Comma-separated exact-origin allowlist (CORS + Origin + CSRF checks).
WEB_ORIGIN=http://localhost:5173,http://localhost:8080
# QC_REVIEW_ENABLED is retired (D-03 decided 2026-11-03: the QC operator makes the final QC
# decision). It is still accepted if set, but it no longer gates anything.
# Demo mode must stay true until Gate D client-rule activation (build prompt section 14).
DEMO_MODE=true
APP_MODE=demo
# Fixed password for the 5 synthetic demo users (brief §9); set a strong value locally.
DEMO_PASSWORD=change-me-demo
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kpmpl-private-documents
S3_ACCESS_KEY=kpmpl-minio
S3_SECRET_KEY=change-me-too
MAX_UPLOAD_MB=10
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SCAN_FAIL_CLOSED=true

# --- database (docker compose maps the same values) ---
POSTGRES_USER=kpmpl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kpmpl
# Host port 55432 (compose maps 55432->5432) to avoid clashing with any local Postgres.
DATABASE_URL=postgresql://kpmpl:change-me@127.0.0.2:55432/kpmpl?schema=public

# --- redis ---
REDIS_URL=redis://localhost:6379

# --- reserved for later phases ---
# JWT_PRIVATE_KEY_BASE64=     (P1: identity)
# JWT_PUBLIC_KEY_BASE64=      (P1: identity)
# MINIO_ROOT_USER=            (P6/M2: private PDF storage)
# MINIO_ROOT_PASSWORD=        (P6/M2)
# S3_ENDPOINT=                (P6/M2)
