# KPMPL edge reverse proxy - local profile (HTTP on :80).
#
# Production: replace `:80` with the client-owned domain (e.g. `ops.kpmpl.example`)
# and Caddy obtains/renews TLS automatically. Then uncomment HSTS below.
#
#	Routes:
#	  /api/*  -> api:3000   (NestJS under /api/v1)
#	  everything else -> web:8080 (nginx SPA)
:80 {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		# Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:8080
	}
}
